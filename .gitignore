apple-health-export.zip
export.xml

# Dependencies
node_modules/
.pnpm-store/

# Next.js build output
.next/
out/

# Production build
dist/

# Testing coverage
coverage/

# Local runtime logs
*.log

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# OS / editor
.DS_Store
.DS_Store?
._*
.Spotlight-V500
.Trashes
ehthumbs.db
Thumbs.db
