# Environment variables — copy this file to .env.local and fill in values
# Never commit .env or .env.local to version control

# Strava OAuth (Phase 1 — obtain from https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback

# Anthropic Claude API (Phase 4 — grounded AI chat, not used until then)
CLAUDE_API_KEY=
